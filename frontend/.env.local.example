NEXT_PUBLIC_API_BASE=http://localhost:8000

# IR-43A — Real Map Operating Surface
# Public MapTiler key consumed by frontend/lib/mapConfig.ts to render the
# MapLibre basemap (hybrid / satellite / streets) on /v2/overview. Without
# this key the RiyadhRealMapSurface renders a safe bilingual fallback
# message in place of the basemap; all governance caveats, zone selector,
# and per-zone evidence panel remain visible. Never commit a real key —
# .env.local is gitignored.
NEXT_PUBLIC_MAPTILER_KEY=
